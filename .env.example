# ==========================================
# BTIB Lab — Environment Variables Example
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit or share .env.local!
# ==========================================

# Database (Neon PostgreSQL)
# Pooled connection string used at runtime by the application
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string used for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (Auth.js / NextAuth v5)
# Generate a secure 32+ character key with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars"
# Canonical URL of your application
AUTH_URL="http://localhost:3000"

# Cloudinary Media Management
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Super-Admin Seed Credentials (USED ONLY BY prisma/seed.ts)
ADMIN_EMAIL="admin@btiblab.ju.edu.bd"
ADMIN_PASSWORD="your-secure-admin-password"
